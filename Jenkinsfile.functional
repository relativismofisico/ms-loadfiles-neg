pipeline {
    agent any

    parameters {
        choice(name: 'AMBIENTE', choices: ['dev', 'qa', 'staging', 'prod'], description: 'Ambiente de pruebas')
        choice(name: 'SUITE', choices: ['smoke', 'regression', 'full'], description: 'Suite Karate a ejecutar')
    }

    environment {
        JAVA_HOME = tool 'JDK17'
        PATH = "${JAVA_HOME}/bin:${PATH}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Pruebas Funcionales Karate') {
            when {
                expression { params.AMBIENTE != 'prod' || params.SUITE == 'smoke' }
            }
            steps {
                withCredentials([
                    string(credentialsId: "karate-jwt-secret-${params.AMBIENTE}", variable: 'KARATE_JWT_SECRET'),
                    string(credentialsId: "karate-base-url-${params.AMBIENTE}", variable: 'KARATE_BASE_URL'),
                    string(credentialsId: "karate-company-id-${params.AMBIENTE}", variable: 'KARATE_COMPANY_ID'),
                    string(credentialsId: "karate-user-id-${params.AMBIENTE}", variable: 'KARATE_USER_ID'),
                    string(credentialsId: "karate-file-id-${params.AMBIENTE}", variable: 'KARATE_FILE_ID')
                ]) {
                    sh """
                        chmod +x gradlew
                        ./gradlew automatedTest \\
                          -PAMBIENTE_PIPE=${params.AMBIENTE} \\
                          -Pkarate.jwt.secret="\${KARATE_JWT_SECRET}" \\
                          -Pkarate.base.url="\${KARATE_BASE_URL}" \\
                          -Pkarate.test.companyId="\${KARATE_COMPANY_ID}" \\
                          -Pkarate.test.userId="\${KARATE_USER_ID}" \\
                          -Pkarate.test.fileId="\${KARATE_FILE_ID}"
                    """
                }
            }
            post {
                always {
                    junit 'build/test-results/automatedTest/**/*.xml'
                    publishHTML(target: [
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'build/reports/tests/automatedTest',
                        reportFiles: 'index.html',
                        reportName: 'Karate HTML Report'
                    ])
                }
            }
        }

        stage('Pruebas Solo Lectura — PROD') {
            when {
                expression { params.AMBIENTE == 'prod' }
            }
            steps {
                withCredentials([
                    string(credentialsId: "karate-jwt-secret-prod", variable: 'KARATE_JWT_SECRET'),
                    string(credentialsId: "karate-base-url-prod", variable: 'KARATE_BASE_URL')
                ]) {
                    sh """
                        chmod +x gradlew
                        AMBIENTE_PIPE=prod ./gradlew automatedTest \\
                          -Pkarate.jwt.secret="\${KARATE_JWT_SECRET}" \\
                          -Pkarate.base.url="\${KARATE_BASE_URL}"
                    """
                }
            }
        }
    }
}