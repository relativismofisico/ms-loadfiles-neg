    "_postman_id": "c7f3a2b1-d4e5-4f6a-8b9c-0d1e2f3a4b5c",
    "name": "ms-loadfiles-neg — Smoke Tests",
    "description": "Colección de smoke tests para el microservicio ms-loadfiles-neg (Karonte/Factoring).\n\n**Puerto:** 8081  \n**context-path:** /load  \n**Auth:** JWT HS256 — se genera automáticamente en el pre-request de la colección.\n\n**Roles disponibles (variable `jwt_rol`):**\n- `ADMINISTRADOR` — acceso a todos los grupos\n- `EMPRESA` — grupos: todos, carga, firma-guardado\n- `OPERARIO` — grupos: todos, carga, revision, firma-subida\n- `FONDEADOR` — grupos: todos, revision\n\n**Variables requeridas:** ajustar en el environment adjunto.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",       "value": "http://localhost:8081/load", "type": "string" },
    { "key": "jwt_secret",     "value": "AF84F1FGllNpNnLG055fdg5hGHJK4KGG5VH5TR5J05JFGGDFDGXVV545J4505G666JFGF2mMY95y", "type": "string" },
    { "key": "jwt_rol",        "value": "ADMINISTRADOR", "type": "string" },
    { "key": "jwt_token",      "value": "", "type": "string" },
    { "key": "company_id",     "value": "1", "type": "string" },
    { "key": "company_name",   "value": "empresa-test", "type": "string" },
    { "key": "company_file_id","value": "1", "type": "string" },
    { "key": "file_signed_id", "value": "1", "type": "string" },
    { "key": "file_to_sign_id","value": "1", "type": "string" },
    { "key": "sign_company_id","value": "1", "type": "string" },
    { "key": "sign_user_id",   "value": "1", "type": "string" },
    { "key": "user_id",        "value": "0", "type": "string" },
    { "key": "ip_load",        "value": "127.0.0.1", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{jwt_token}}", "type": "string" }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Genera JWT HS256 para cada request de la colección",
          "const secret = pm.collectionVariables.get('jwt_secret');",
          "const rol    = pm.collectionVariables.get('jwt_rol') || 'ADMINISTRADOR';",
          "",
          "function b64url(str) {",
          "    return btoa(str).replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=/g, '');",
          "}",
          "",
          "const now    = Math.floor(Date.now() / 1000);",
          "const header  = b64url(JSON.stringify({ alg: 'HS256', typ: 'JWT' }));",
          "const payload = b64url(JSON.stringify({ sub: 'smoke-tester', rol: rol, iat: now, exp: now + 3600 }));",
          "const input   = header + '.' + payload;",
          "",
          "const sig = CryptoJS.HmacSHA256(input, secret)",
          "    .toString(CryptoJS.enc.Base64)",
          "    .replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=/g, '');",
          "",
          "pm.collectionVariables.set('jwt_token', input + '.' + sig);"
        ]
      }
    }
  ],
