  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan"
              testname="ms-loadfiles-neg — Plan Maestro de Rendimiento" enabled="true">
      <stringProp name="TestPlan.comments">Spring Boot 3.3.4 | JWT HS256 | 12 endpoints | 3 perfiles | Generado 2026-06-22</stringProp>
