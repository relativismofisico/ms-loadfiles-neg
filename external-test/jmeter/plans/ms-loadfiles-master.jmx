    </TestPlan>
    <hashTree>

      <!-- ═══════════════════════════════════════════════════════════ -->
      <!--  SETUP: Generación JWT Bearer Token + carga de config      -->
      <!--  Genera token válido 24h con rol=ADMINISTRADOR             -->
      <!--  Usa mismo secret BASE64 que application.yml (JJWT 0.12.3) -->
      <!-- ═══════════════════════════════════════════════════════════ -->
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup"
                        testname="SetUp — JWT y Validación de Configuración" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">stoptest</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController"
                     guiclass="LoopControlGui" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </SetupThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler"
                       testname="Generar JWT Bearer Token (HS256)" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script"><![CDATA[
import javax.crypto.Mac
import javax.crypto.spec.SecretKeySpec
import java.util.Base64

def ambiente     = props.get("AMBIENTE_PIPE", "dev")
def jwtSecret    = props.get("jwt.secret")
def jwtRol       = props.get("jwt.rol", "ADMINISTRADOR")
def jwtSub       = props.get("jwt.subject", "jmeter-perf-test")
def prodSafeOnly = props.get("prod.safe.only", "false")

if (jwtSecret == null || jwtSecret.trim().isEmpty()) {
    log.error("[SetUp] jwt.secret no configurado. Ejecutar con: -p config/" + ambiente + ".properties")
    throw new Exception("jwt.secret requerido en el properties file del ambiente")
}

// Decodificar secret en BASE64 — igual que JJWT Decoders.BASE64.decode()
byte[] secretBytes = Base64.decoder.decode(jwtSecret.trim())

// Construir header JWT
String headerJson  = '{"alg":"HS256","typ":"JWT"}'
String headerB64   = Base64.urlEncoder.withoutPadding().encodeToString(headerJson.getBytes("UTF-8"))

// Construir payload JWT — claim 'rol' singular (requerido por JwtAuthenticationFilter)
long nowSecs = System.currentTimeMillis() / 1000L
long expSecs = nowSecs + 86400L  // 24h
String payloadJson = '{"sub":"' + jwtSub + '","rol":"' + jwtRol + '","iat":' + nowSecs + ',"exp":' + expSecs + '}'
String payloadB64  = Base64.urlEncoder.withoutPadding().encodeToString(payloadJson.getBytes("UTF-8"))

// Firmar con HMAC-SHA256
String signingInput = headerB64 + "." + payloadB64
Mac mac = Mac.getInstance("HmacSHA256")
mac.init(new SecretKeySpec(secretBytes, "HmacSHA256"))
byte[] sigBytes   = mac.doFinal(signingInput.getBytes("UTF-8"))
String signature  = Base64.urlEncoder.withoutPadding().encodeToString(sigBytes)

String token = signingInput + "." + signature

// Publicar como JMeter property (accesible desde todos los thread groups)
props.put("jwt.token.generated", token)
props.put("PROD_SAFE_ONLY", prodSafeOnly)

log.info("[SetUp] JWT generado | ambiente=" + ambiente + " | rol=" + jwtRol + " | prod.safe.only=" + prodSafeOnly)
log.info("[SetUp] Token generado exitosamente (" + token.length() + " chars)")

SampleResult.setResponseData("JWT generado OK | rol=" + jwtRol + " | ambiente=" + ambiente, "UTF-8")
SampleResult.setSuccessful(true)
          ]]></stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>

      <!-- ═══════════════════════════════════════════════════════════ -->
      <!--  PERFIL 1 — SMOKE: 1 hilo | 1 loop | Todos los endpoints  -->
