<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan"
              testname="ms-loadfiles-neg — Carga Básica (10 hilos / 5 min)" enabled="true">
      <stringProp name="TestPlan.comments">Carga básica: 10 hilos | 30s ramp-up | 5 min duration | GET + write endpoints</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments"
                   guiclass="ArgumentsPanel" testclass="Arguments" testname="Variables de Usuario" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="host" elementType="Argument">
            <stringProp name="Argument.name">host</stringProp>
            <stringProp name="Argument.value">${__P(host,localhost)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="port" elementType="Argument">
            <stringProp name="Argument.name">port</stringProp>
            <stringProp name="Argument.value">${__P(port,8081)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="protocol" elementType="Argument">
            <stringProp name="Argument.name">protocol</stringProp>
            <stringProp name="Argument.value">${__P(protocol,http)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="data.dir" elementType="Argument">
            <stringProp name="Argument.name">data.dir</stringProp>
            <stringProp name="Argument.value">${__P(data.dir,external-test/jmeter/data/dev)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="ip.load" elementType="Argument">
            <stringProp name="Argument.name">ip.load</stringProp>
            <stringProp name="Argument.value">${__P(ip.load,127.0.0.1)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="file.type.id" elementType="Argument">
            <stringProp name="Argument.name">file.type.id</stringProp>
            <stringProp name="Argument.value">${__P(file.type.id,1)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>

      <!-- SetUp: JWT -->
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup"
                        testname="SetUp — JWT Token" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">stoptest</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController"
                     guiclass="LoopControlGui" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
      </SetupThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler"
                       testname="Generar JWT HS256" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script"><![CDATA[
import javax.crypto.Mac
import javax.crypto.spec.SecretKeySpec
import java.util.Base64

def jwtSecret = props.get("jwt.secret")
def jwtRol    = props.get("jwt.rol", "ADMINISTRADOR")
def jwtSub    = props.get("jwt.subject", "jmeter-load")

if (jwtSecret == null || jwtSecret.trim().isEmpty()) {
    throw new Exception("[Load] jwt.secret requerido. Ejecutar con: -p config/dev.properties")
}

byte[] secretBytes = Base64.decoder.decode(jwtSecret.trim())
String headerJson  = '{"alg":"HS256","typ":"JWT"}'
String headerB64   = Base64.urlEncoder.withoutPadding().encodeToString(headerJson.getBytes("UTF-8"))

long nowSecs = System.currentTimeMillis() / 1000L
String payloadJson = '{"sub":"' + jwtSub + '","rol":"' + jwtRol + '","iat":' + nowSecs + ',"exp":' + (nowSecs + 86400L) + '}'
String payloadB64  = Base64.urlEncoder.withoutPadding().encodeToString(payloadJson.getBytes("UTF-8"))

String signingInput = headerB64 + "." + payloadB64
Mac mac = Mac.getInstance("HmacSHA256")
mac.init(new SecretKeySpec(secretBytes, "HmacSHA256"))
String signature = Base64.urlEncoder.withoutPadding().encodeToString(mac.doFinal(signingInput.getBytes("UTF-8")))

props.put("jwt.token.generated", signingInput + "." + signature)
props.put("PROD_SAFE_ONLY", props.get("prod.safe.only", "false"))
log.info("[Load SetUp] JWT OK | rol=" + jwtRol)
SampleResult.setSuccessful(true)
          ]]></stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>

      <!-- Thread Group Carga -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup"
                   testname="Carga Básica — ${__P(profile2.threads,10)} hilos / ${__P(profile2.duration,300)}s" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController"
                     guiclass="LoopControlGui" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">${__P(profile2.loops,-1)}</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(profile2.threads,10)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(profile2.rampup,30)}</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__P(profile2.duration,300)}</stringProp>
        <stringProp name="ThreadGroup.delay">2</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">false</boolProp>
      </ThreadGroup>
      <hashTree>

        <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement"
