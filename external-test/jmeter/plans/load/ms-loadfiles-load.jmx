        <!-- IfController escritura -->
        <IfController guiclass="IfControllerPanel" testclass="IfController"
                      testname="IF — skip escritura en prod" enabled="true">
          <stringProp name="IfController.condition">"${__P(PROD_SAFE_ONLY,false)}" == "false"</stringProp>
