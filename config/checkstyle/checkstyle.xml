<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Ruleset compatible con Checkstyle 10.17.0 + Gradle 8.x
  Basado en Google Java Style - reglas de bajo ruido.
-->
<module name="Checker">
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <!-- ══ Checks a nivel de archivo ═════════════════════════════════════ -->
  <module name="NewlineAtEndOfFile"/>

  <module name="FileLength">
    <property name="max" value="1200"/>
  </module>

  <module name="FileTabCharacter">
    <property name="eachLine" value="true"/>
  </module>

  <module name="LineLength">
    <property name="max" value="180"/>
    <property name="ignorePattern" value="^package.*|^import.*|^ *\* *https?://"/>
  </module>

  <!-- ══ Checks a nivel de árbol sintáctico ════════════════════════════ -->
  <module name="TreeWalker">

    <module name="OuterTypeFilename"/>
    <module name="AvoidStarImport"/>
    <module name="RedundantImport"/>
    <module name="UnusedImports"/>

    <module name="CustomImportOrder">
      <property name="customImportOrderRules"
                value="STANDARD_JAVA_PACKAGE###SPECIAL_IMPORTS###THIRD_PARTY_PACKAGE"/>
      <property name="standardPackageRegExp" value="^(java|javax|jakarta)\."/>
      <property name="specialImportsRegExp" value="^cl\.bank\."/>
      <property name="separateLineBetweenGroups" value="true"/>
      <property name="sortImportsInGroupAlphabetically" value="true"/>
    </module>

    <module name="EmptyLineSeparator">
      <property name="allowNoEmptyLineBetweenFields" value="true"/>
    </module>

    <module name="AvoidInlineConditionals"/>

    <module name="AnnotationLocation">
      <property name="allowSamelineSingleParameterlessAnnotation" value="true"/>
      <property name="allowSamelineParameterizedAnnotation" value="false"/>
      <property name="allowSamelineMultipleAnnotations" value="false"/>
    </module>

    <module name="MissingJavadocType">
      <property name="scope" value="public"/>
    </module>

    <module name="MissingJavadocMethod">
      <property name="scope" value="public"/>
      <property name="allowedAnnotations"
                value="Override,Test,BeforeEach,AfterEach,BeforeAll,AfterAll,ParameterizedTest,Bean"/>
    </module>

    <module name="JavadocVariable">
      <property name="tokens" value="VARIABLE_DEF"/>
      <property name="scope" value="public"/>
    </module>

    <module name="FinalClass"/>
    <module name="HideUtilityClassConstructor"/>
    <module name="EqualsHashCode"/>

    <module name="IllegalTokenText">
      <property name="tokens" value="STRING_LITERAL, CHAR_LITERAL"/>
      <property name="format"
                value="\\u00(09|0A|0B|0C|0D)|\\u0085|\\u2028|\\u2029"/>
      <property name="message"
                value="Avoid escaped control characters in literals; use visible escaped forms."/>
    </module>

    <module name="MethodLength">
      <property name="max" value="120"/>
    </module>

    <module name="ParameterNumber">
      <property name="max" value="7"/>
    </module>

    <module name="MissingSwitchDefault"/>
    <module name="FallThrough"/>
    <module name="SimplifyBooleanExpression"/>
    <module name="SimplifyBooleanReturn"/>
    <module name="MultipleVariableDeclarations"/>
    <module name="EmptyStatement"/>
    <module name="RedundantModifier"/>
    <module name="DefaultComesLast"/>
    <module name="UpperEll"/>
    <module name="ArrayTypeStyle"/>

    <module name="RequireThis">
      <property name="checkFields" value="true"/>
      <property name="checkMethods" value="false"/>
    </module>

    <module name="UnnecessaryParentheses"/>
    <module name="TodoComment"/>
    <module name="TrailingComment"/>

    <module name="SeparatorWrap">
      <property name="option" value="eol"/>
      <property name="tokens" value="COMMA,SEMI,ELLIPSIS,ARRAY_DECLARATOR"/>
    </module>

    <module name="OperatorWrap">
      <property name="option" value="nl"/>
    </module>

    <module name="ConstantName"/>
    <module name="LocalVariableName"/>
    <module name="ParameterName"/>

    <module name="MethodName">
      <property name="format" value="^[a-z][a-zA-Z0-9_]*$"/>
    </module>

    <module name="TypeName"/>
    <module name="NeedBraces"/>
    <module name="WhitespaceAround"/>
    <module name="NoWhitespaceBefore"/>
    <module name="OneStatementPerLine"/>
    <module name="ModifierOrder"/>
    <module name="EmptyBlock"/>
    <module name="LeftCurly"/>
    <module name="RightCurly"/>

    <!-- Supresiones por xpath para ArchitectureTest.java -->
    <module name="SuppressionXpathSingleFilter">
      <property name="checks" value="ConstantName"/>
      <property name="files" value=".*[/\\\\]ArchitectureTest\.java$"/>
    </module>

    <!-- Supresiones para clases Utility con @UtilityClass (Lombok genera constructor privado) -->
    <module name="SuppressionXpathSingleFilter">
      <property name="checks" value="HideUtilityClassConstructor"/>
      <property name="files" value=".*[/\\\\](FormatoUtil|MimeTypeUtil|NombreArchivoUtil|MsInstruccionesUtilApplication)\.java$"/>
    </module>

  </module>

  <!-- Supresión de FileLength para ArchitectureTest a nivel Checker -->
  <module name="SuppressionSingleFilter">
    <property name="checks" value="FileLength"/>
    <property name="files" value=".*[/\\\\]ArchitectureTest\.java$"/>
  </module>

</module>
