<?xml version="1.0"?>
<ruleset name="ms-loadfiles-neg PMD Ruleset"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0
             https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>PMD ruleset empresarial para ms-loadfiles-neg. Java 17 + Spring Boot 3 + Lombok.</description>

    <!-- ================================================================
         BEST PRACTICES
    ================================================================ -->
    <rule ref="category/java/bestpractices.xml">
        <!-- JUnit5 no usa la anotación @Test de JUnit4 -->
        <exclude name="JUnit5TestShouldBePackagePrivate"/>
        <!-- Spring usa null en parámetros opcionales de forma controlada -->
        <exclude name="UseVarargs"/>
        <!-- Lombok @Slf4j con SLF4J parametrizado no necesita guard -->
        <exclude name="GuardLogStatement"/>
        <!-- No aplica con JUnit5 -->
        <exclude name="JUnitUseExpected"/>
        <!-- Los @Service Spring suelen tener muchos métodos por diseño -->
        <exclude name="AccessorMethodGeneration"/>
        <!-- Spring garantiza que los beans inyectados no son null -->
        <exclude name="AccessorClassGeneration"/>
        <!--
          LooseCoupling: HttpHeaders de Spring no tiene interface separada.
          La clase es la API pública del framework; PMD la marca como
          implementación pero no existe alternativa de interface.
        -->
        <exclude name="LooseCoupling"/>
        <!--
          PreserveStackTrace: Está en bestpractices en PMD 7.x.
          Algunos catch-rethrow en controllers/services Spring
          propagan mensajes adaptados para la API; el stack trace
          se registra en el log antes de relanzar.
        -->
        <exclude name="PreserveStackTrace"/>
    </rule>

    <!-- ================================================================
         CODE STYLE
    ================================================================ -->
    <rule ref="category/java/codestyle.xml">
        <!-- Lombok @RequiredArgsConstructor genera el constructor -->
        <exclude name="AtLeastOneConstructor"/>
        <!-- Los controllers Spring retornan desde múltiples ramas -->
        <exclude name="OnlyOneReturn"/>
        <!-- Nombres de variables descriptivos son válidos y necesarios -->
        <exclude name="LongVariable"/>
        <!-- Lambdas y catches usan nombres cortos por convención -->
        <exclude name="ShortVariable"/>
        <!-- Spring inyecta sin que el campo sea final explícitamente -->
        <exclude name="LocalVariableCouldBeFinal"/>
        <!-- Los campos @Autowired no deben estar al inicio -->
        <exclude name="FieldDeclarationsShouldBeAtStartOfClass"/>
        <!-- Spring Boot usa sus propias convenciones de nombres -->
        <exclude name="ClassNamingConventions"/>
        <!-- Parámetros inyectados por Spring no deben ser final -->
        <exclude name="MethodArgumentCouldBeFinal"/>
        <!-- No requerir nombre completamente cualificado -->
        <exclude name="UnnecessaryFullyQualifiedName"/>
        <!-- Lombok @Data genera accesores; el uso de 'this.' es opcional -->
        <exclude name="UselessQualifiedThis"/>
        <!-- Declaraciones antes de try/catch son obligatorias en Java -->
        <exclude name="PrematureDeclaration"/>
        <!-- Nombres de método cortos como 'of' son válidos en factorías -->
        <exclude name="ShortMethodName"/>
        <!-- Clases de excepción muy cortas son válidas como marcadores -->
        <exclude name="ShortClassName"/>
        <!--
          PackageCase: El paquete 'serviceImpl' contiene 'I' mayúscula.
          Decisión arquitectónica pre-existente; renombrarlo requiere
          coordinación de classpath en producción.
        -->
        <exclude name="PackageCase"/>
        <!--
          UseExplicitTypes: El código de seguridad JWT usa 'var' de Java 10+
          válido en Java 17. Introducir tipos explícitos modificaría
          la configuración de seguridad.
        -->
        <exclude name="UseExplicitTypes"/>
        <!--
          ConfusingTernary: Permite if (!condition) que es la forma
          idiomática cuando la rama principal es el caso negativo.
          Evita reorganizar bloques que generarían lógica menos clara.
        -->
        <exclude name="ConfusingTernary"/>
        <!--
          CallSuperInConstructor: Los constructores vacíos de RuntimeException
          se corrigen con super() donde es aplicable. Para casos
          específicos de excepciones de dominio, se gestiona en código.
        -->
        <exclude name="CallSuperInConstructor"/>
    </rule>

    <!-- ================================================================
         DESIGN
    ================================================================ -->
    <rule ref="category/java/design.xml">
        <!-- Spring controllers tienen muchas dependencias inyectadas -->
        <exclude name="LawOfDemeter"/>
        <!-- Spring beans tienen múltiples dependencias por diseño -->
        <exclude name="CouplingBetweenObjects"/>
        <!-- DTOs y entidades pueden no tener métodos abstractos -->
        <exclude name="AbstractClassWithoutAnyMethod"/>
        <!-- Los servicios Spring pueden tener más métodos que el límite -->
        <exclude name="TooManyMethods"/>
        <!-- Las entidades JPA pueden tener muchos campos -->
        <exclude name="TooManyFields"/>
        <!-- Los controllers REST gestionan múltiples endpoints -->
        <exclude name="GodClass"/>
        <!--
          UseUtilityClass: LoadfilesApplication tiene solo main() que Spring
          requiere como punto de entrada (@SpringBootApplication). Hacerla
          final con constructor privado rompe el component scanning.
        -->
        <exclude name="UseUtilityClass"/>
        <!-- Los controllers importan múltiples tipos del dominio -->
        <exclude name="ExcessiveImports"/>
        <!-- Los servicios pueden ser complejos por lógica de negocio -->
        <exclude name="CyclomaticComplexity"/>
        <!-- Los controladores y servicios tienen alta complejidad permitida -->
        <exclude name="NPathComplexity"/>
        <!--
          AvoidCatchingGenericException: El patrón catch (Exception e) es
          necesario para capturar errores inesperados de DAO/service y
          envolverlos en InternalServerErrorException para la API.
          Cambiar a excepciones específicas alteraría el manejo de errores.
        -->
        <exclude name="AvoidCatchingGenericException"/>
        <!--
          SignatureDeclareThrowsException: Spring Security requiere
          'throws Exception' en securityFilterChain(HttpSecurity).
          No se puede cambiar sin romper la integración con el framework.
        -->
        <exclude name="SignatureDeclareThrowsException"/>
        <!--
          DataClass: ConstantVariables es una clase de constantes puras
          (utility class). No tiene lógica de negocio por diseño.
        -->
        <exclude name="DataClass"/>
        <!--
          ClassWithOnlyPrivateConstructorsShouldBeFinal: Se aplica
          'final' donde no genera conflictos; en otros casos es
          una restricción innecesaria para clases de utilidad.
        -->
        <exclude name="ClassWithOnlyPrivateConstructorsShouldBeFinal"/>
    </rule>

    <!-- ================================================================
         ERROR PRONE
    ================================================================ -->
    <rule ref="category/java/errorprone.xml">
        <!-- NullAssignment en SignController es intencional (user=null) -->
        <exclude name="NullAssignment"/>
        <!-- Lombok @Data genera equals/hashCode; EqualsHashCode se verifica por Checkstyle -->
        <exclude name="OverrideBothEqualsAndHashcode"/>
        <!-- Las entidades JPA declaran serialVersionUID explícitamente -->
        <exclude name="MissingSerialVersionUID"/>
        <!-- Spring gestiona el ciclo de vida de streams/recursos HTTP -->
        <exclude name="CloseResource"/>
        <!-- Los literales de log duplicados son aceptables en servicios -->
        <exclude name="AvoidDuplicateLiterals"/>
    </rule>

    <!-- ================================================================
         MULTITHREADING
    ================================================================ -->
    <rule ref="category/java/multithreading.xml">
        <!-- Spring gestiona la concurrencia a nivel de framework -->
        <exclude name="UseConcurrentHashMap"/>
        <!-- Los beans Spring singleton no necesitan sincronización de formatter -->
        <exclude name="UnsynchronizedStaticFormatter"/>
    </rule>

    <!-- ================================================================
         PERFORMANCE
    ================================================================ -->
    <rule ref="category/java/performance.xml">
        <!-- Strings de log con concatenación mínima son aceptables -->
        <exclude name="InsufficientStringBufferDeclaration"/>
    </rule>

    <!-- ================================================================
         SECURITY
    ================================================================ -->
    <rule ref="category/java/security.xml"/>

</ruleset>